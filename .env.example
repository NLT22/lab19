# OpenAI (primary LLM + embeddings) — leave blank to use LM Studio for everything
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL=gpt-5-nano  (poor JSON instruction following — not recommended for extraction)
OPENAI_EMBED_MODEL=text-embedding-3-small

# LM Studio (fallback chat + always-on embeddings)
LM_STUDIO_URL=http://127.0.0.1:1234
LM_STUDIO_CHAT_MODEL=qwen/qwen3.5-9b
# LM_STUDIO_CHAT_MODEL=openai/gpt-oss-20b
LM_STUDIO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# Neo4j Desktop
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<password>

# Data paths
PDF_DIR=data/pdfs
CHUNKS_PATH=data/chunks.json
CHUNK_SIZE=800
CHUNK_OVERLAP=100
